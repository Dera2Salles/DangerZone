# WordPress Configuration
# Copy this file to .env.local and fill in your WordPress credentials

# Your WordPress site URL (without trailing slash)
VITE_WORDPRESS_SITE_URL=http://localhost:8080

# WordPress username
VITE_WORDPRESS_USERNAME=ariel

# WordPress Application Password
# Generate this in WordPress Admin: Users → Profile → Application Passwords
VITE_WORDPRESS_APP_PASSWORD=arielpasssecret
